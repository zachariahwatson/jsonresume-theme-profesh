{{#if resume.education.length}}
    <section id="education">
        <h2>Education</h2>
        {{#each resume.education}}
            {{#> item title=institution subtitle=(joinEducation studyType area) location=location startDate=startDate endDate=endDate url=url}}
                    <ul>
                        {{#if score}}
                            <li>
                                <div class="score">
                                    {{score}}
                                </div>
                            </li>
                        {{/if}}
                        
                    {{#if courses.length}}
                        <li>
                            <div class="courses">
                                {{#each courses}}
                                    {{this}}{{#unless @last}}, {{/unless}}
                                {{/each}}
                            </div>
                        </li>
                    {{/if}}
                    </ul>
            {{/item}}
        {{/each}}
    </section>
{{/if}}
