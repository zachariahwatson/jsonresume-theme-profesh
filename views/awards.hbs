{{#if resume.awards.length}}
	<section id="awards">
		<h2>Awards & Recognitions</h2>
        {{#each resume.awards}}
            {{#> item title=title subtitle=awarder endDate=date}}
                {{#if summary}}
                    <ul class="highlights">
                        <li>{{summary}}</li>
                    </ul>
                {{/if}}
            {{/item}}
        {{/each}}
    </section>
{{/if}}